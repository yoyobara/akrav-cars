# Postgres. Neon works out of the box; so does any Postgres 13+ with btree_gist.
# Neon: copy the pooled connection string from the dashboard and keep sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/akrav?sslmode=require"

# Signs the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Sent to Nominatim when reverse geocoding, as its usage policy requires.
NOMINATIM_USER_AGENT="akrav-cars/0.1 (you@example.com)"

# Google sign-in (SPEC §9). Create a "Web application" OAuth client and add
# <origin>/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
